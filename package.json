{
 "name": "easycare",
 "version": "1.3.0",
 "description": "安心提醒 EasyCare",
 "main": "electron/main.js",
 "author": {
  "name": "EasyCare",
  "email": "support@easycare.local"
 },
 "scripts": {
  "start": "electron .",
  "web": "npx serve web",
  "build:win": "electron-builder --win nsis",
  "build:mac": "electron-builder --mac dmg",
  "build": "electron-builder",
  "build:linux": "electron-builder --linux AppImage deb",
  "cap:android": "cap sync android && cap open android",
  "cap:ios": "cap sync ios && cap open ios",
  "server": "node server/server.js",
  "test": "node tests/test.js",
  "get-llm": "node scripts/get-llm.js"
 },
 "devDependencies": {
  "electron": "^33.0.0",
  "electron-builder": "^25.0.0",
  "@capacitor/cli": "^6.0.0"
 },
 "build": {
  "appId": "app.easycare.reminder",
  "productName": "安心提醒",
  "files": [
   "electron/**",
   "web/**"
  ],
  "win": {
   "target": "nsis"
  },
  "mac": {
   "target": "dmg",
   "category": "public.app-category.lifestyle"
  },
  "linux": {
   "target": [
    "AppImage",
    "deb"
   ],
   "category": "Utility"
  },
  "extraResources": [
   {
    "from": "llm",
    "to": "llm"
   }
  ],
  "asarUnpack": []
 },
 "dependencies": {
  "@capacitor/core": "^6.0.0",
  "@capacitor/android": "^6.0.0",
  "@capacitor/ios": "^6.0.0",
  "@capacitor/local-notifications": "^6.0.0"
 }
}